---
import { getCollection, render } from "astro:content";
import ExperienceDialog from "./ExperienceDialog.astro";
import PortfolioItem from "./PortfolioItem.astro";
import PortfolioSection from "./PortfolioSection.astro";
import ProjectDialog from "./ProjectDialog.astro";

const byOrder = <T extends { data: { order: number } }>(a: T, b: T) =>
  a.data.order - b.data.order;

const experiences = (
  await getCollection("experiences", ({ data }) => !data.draft)
).sort(byOrder);
const achievements = (
  await getCollection("achievements", ({ data }) => !data.draft)
).sort(byOrder);
const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort(byOrder);
const education = (
  await getCollection("education", ({ data }) => !data.draft)
).sort(byOrder);

const renderedExperiences = await Promise.all(
  experiences.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);
const renderedProjects = await Promise.all(
  projects.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);
---

<main
  class="row-start-2 flex w-full flex-col items-center space-y-7 sm:items-start"
>
  <PortfolioSection title="Experience">
    {
      renderedExperiences.map(({ entry, Content }) => {
        const itemId = `experience-${entry.id}`;
        const dialogId = `${itemId}-dialog`;

        return (
          <PortfolioItem
            id={itemId}
            title={entry.data.title}
            metaLabel="Period"
            metaValue={entry.data.period}
          >
            <ExperienceDialog
              id={dialogId}
              title={entry.data.title}
              period={entry.data.period}
              location={entry.data.location}
            >
              <Content />
            </ExperienceDialog>
          </PortfolioItem>
        );
      })
    }
  </PortfolioSection>

  <PortfolioSection title="Projects">
    {
      renderedProjects.map(({ entry, Content }) => {
        const itemId = `project-${entry.id}`;
        const dialogId = `${itemId}-dialog`;

        return (
          <PortfolioItem
            id={itemId}
            title={entry.data.title}
            metaLabel="Type"
            metaValue={entry.data.kind}
          >
            <ProjectDialog
              id={dialogId}
              title={entry.data.title}
              kind={entry.data.kind}
              link={entry.data.link}
              linkLabel={entry.data.linkLabel}
            >
              <Content />
            </ProjectDialog>
          </PortfolioItem>
        );
      })
    }
  </PortfolioSection>

  <PortfolioSection title="Achievement">
    {
      achievements.map((entry) => (
        <PortfolioItem
          id={`achievement-${entry.id}`}
          title={entry.data.title}
          metaLabel="Time"
          metaValue={entry.data.time}
        />
      ))
    }
  </PortfolioSection>

  <PortfolioSection title="Education">
    {
      education.map((entry) => (
        <PortfolioItem
          id={`education-${entry.id}`}
          title={entry.data.institution}
          metaLabel="Period"
          metaValue={entry.data.period}
        />
      ))
    }
  </PortfolioSection>
</main>
