---
import DetailDialog from "./DetailDialog.astro";

interface Props {
  id: string;
  title: string;
  period: string;
  location?: string;
}

const { id, title, period, location } = Astro.props;
const metadata = [
  { label: "Period", value: period },
  ...(location ? [{ label: "Location", value: location }] : []),
];
---

<DetailDialog
  id={id}
  eyebrow="Experience details"
  title={title}
  metadata={metadata}
>
  <slot />
</DetailDialog>
