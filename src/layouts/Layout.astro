---
import "@fontsource/press-start-2p/400.css";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Naga's Porto",
  description =
    "This is a personal portofolio for Kenzie Raditya Tirtarahardja with 8-bit theme.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <slot />
    <script src="../scripts/portfolio-interactions.ts"></script>
  </body>
</html>
